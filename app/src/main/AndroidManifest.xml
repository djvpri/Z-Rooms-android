<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Pembaruan mandiri: APK versi baru diunduh lalu diserahkan ke pemasang
         paket Android. Sejak Android 8 setiap aplikasi yang memasang APK
         WAJIB punya izin ini, dan pengguna harus menyalakannya sendiri lewat
         "Pasang aplikasi tak dikenal" — tak ada jalan memasang diam-diam. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Kamera. Kasir memotret KTP langsung dari halaman booking, dan APK ini
         MEMANGGIL aplikasi kamera lewat ACTION_IMAGE_CAPTURE.

         Dokumen Android menuntut izin ini untuk ACTION_IMAGE_CAPTURE: tanpa
         izin yang sudah diberikan, panggilan itu melempar SecurityException —
         dan pada Android 15 lemparan itu menjatuhkan PROSES, bukan cuma
         memunculkan pesan. Itulah "aplikasi keluar sendiri saat klik kamera".

         Diminta saat kasir benar-benar menekan tombol Kamera (lihat
         PemilihBerkas.mintaKamera), bukan saat aplikasi dibuka: kasir yang
         hanya memilih berkas dari galeri tak pernah melihat dialog izin. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Printer struk Bluetooth. Kasir mencetak bon ke printer thermal yang
         dipasangkan ke tablet/HP kasir.

         DUA izin karena aturannya berubah di Android 12 (API 31):
           - API 31+ : BLUETOOTH_CONNECT (menyambung) + BLUETOOTH_SCAN
                       (menemukan). Keduanya izin RUNTIME, jadi diminta saat
                       kasir menekan tombol cetak — lihat PrinterBluetooth.
           - API <=30: BLUETOOTH + BLUETOOTH_ADMIN, keduanya izin biasa yang
                       cukup dideklarasikan. `maxSdkVersion` membatasinya supaya
                       Android 12+ tak menampilkan izin usang ini di daftar.
         Tanpa `neverForLocation` di BLUETOOTH_SCAN, Android menandai aplikasi
         memakai Bluetooth untuk melacak lokasi — dan itu menuntut izin lokasi
         yang sama sekali tak dipakai aplikasi ini. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Bluetooth boleh tak ada; sisanya aplikasi tetap jalan (kasir masih bisa
         memakai peramban di perangkat lain). -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <!-- Bon yang diunduh disimpan ke folder Unduhan; Android 10+ tak butuh
         izin tulis lagi, tapi perangkat lama (API 24-28) butuh. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Ini "kamera ADA di perangkat", bukan izin memakainya — izinnya di
         atas. Perangkat tanpa kamera belakang tetap boleh memasang aplikasi,
         dan tombol "Pilih file" tetap jalan: memilih berkas tak butuh kamera
         sama sekali. Tidak ada fitur kamera di aplikasi ini selain memotret KTP. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- Sejak Android 11 (API 30) APLIKASI LAIN tak terlihat tanpa deklarasi
         ini. PemilihBerkas menanyakan `resolveActivity` untuk memastikan ada
         aplikasi kamera sebelum membukanya; tanpa <queries>, jawabannya selalu
         "tidak ada" walau kameranya jelas ada, dan tombol Kamera jadi mati.
         Izin CAMERA di atas TIDAK menggantikan deklarasi ini: keduanya
         mengurus hal berbeda. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/nama_app"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ZRooms">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Membagikan APK hasil unduhan ke pemasang paket Android. Sejak
             Android 7 berkas tak boleh lagi diserahkan sebagai `file://` —
             pemasang paket menolaknya dengan FileUriExposedException. Berkas
             yang boleh dibuka dibatasi di res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pembaruan"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Foto KTP diserahkan ke aplikasi kamera lewat `content://` dari
             authority ini. Terpisah dari `.pembaruan` di atas karena
             file_paths-nya beda: yang ini cache/ktp-foto, yang itu Unduhan. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.berkas"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths_ktp" />
        </provider>
    </application>

</manifest>
