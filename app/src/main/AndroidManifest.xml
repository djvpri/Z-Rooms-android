<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pembaruan mandiri: APK versi baru diunduh lalu diserahkan ke pemasang
         paket Android. Sejak Android 8 setiap aplikasi yang memasang APK
         WAJIB punya izin ini, dan pengguna harus menyalakannya sendiri lewat
         "Pasang aplikasi tak dikenal" — tak ada jalan memasang diam-diam. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Bon yang diunduh disimpan ke folder Unduhan; Android 10+ tak butuh
         izin tulis lagi, tapi perangkat lama (API 24-28) butuh. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Foto KTP penyewa di halaman booking diambil dari kamera. Ini izin
         "kamera ada di perangkat", BUKAN izin memakai kamera: aplikasi kamera
         yang dipanggil lewat ACTION_IMAGE_CAPTURE meminta izinnya sendiri, jadi
         Z-Rooms tak perlu CAMERA dan tak ada dialog izin tambahan saat memotret.

         Tanpa baris ini, Play Store menyembunyikan aplikasi dari perangkat
         tanpa kamera belakang; dengan baris ini, perangkat tanpa kamera tetap
         bisa memasang dan tombol "Pilih file" tetap jalan. -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/nama_app"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ZRooms">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Membagikan APK hasil unduhan ke pemasang paket Android. Sejak
             Android 7 berkas tak boleh lagi diserahkan sebagai `file://` —
             pemasang paket menolaknya dengan FileUriExposedException. Berkas
             yang boleh dibuka dibatasi di res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pembaruan"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
